{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rodo Upscale",
  "version": "0.1.0",
  "identifier": "com.rodo.upscale",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rodo Upscale",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/realesrgan-ncnn-vulkan"],
    "resources": { "resources/models/": "models/" },
    "windows": {
      "nsis": { "languages": ["French"], "installMode": "currentUser" }
    }
  }
}
